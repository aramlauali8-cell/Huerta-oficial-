</div></div></div>

<div class="modal fade" id="modalLogin" tabindex="-1"><div class="modal-dialog modal-dialog-centered"><div class="modal-content">
  <div class="modal-header"><h5 class="modal-title">🔒 Modo admin</h5><button class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button></div>
  <div class="modal-body"><label class="mb-2" for="codAdmin">Escribe el código de administrador</label>
    <input id="codAdmin" type="password" class="form-control" autocomplete="off"><div id="errCod" class="text-danger small mt-2"></div></div>
  <div class="modal-footer"><button class="btn btn-huerta w-100" id="btnEntrar">Entrar</button></div>
</div></div></div>

<div class="modal fade" id="modalAdmin" tabindex="-1"><div class="modal-dialog modal-dialog-scrollable"><div class="modal-content">
  <div class="modal-header"><h5 class="modal-title">⚙️ Panel de administración</h5><button class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button></div>
  <div class="modal-body">
    <h6>📞 Contactos</h6>
    <input id="c_whatsapp" class="form-control mb-2" placeholder="WhatsApp (ej: 77579228)">
    <input id="c_tiktok" class="form-control mb-2" placeholder="TikTok (usuario o enlace)">
    <input id="c_facebook" class="form-control mb-2" placeholder="Facebook (usuario o enlace)">
    <input id="c_instagram" class="form-control mb-2" placeholder="Instagram (usuario o enlace)">
    <button class="btn btn-huerta w-100 mb-3" id="btnGuardarContactos">Guardar contactos</button>
    <h6>🌱 Logotipo</h6>
    <input type="file" id="logoFile" accept="image/*" class="form-control mb-2">
    <button class="btn btn-sm btn-outline-secondary mb-3" id="btnQuitarLogo">Quitar logo</button>
    <h6>🖼️ Fotos del carrusel</h6>
    <input type="file" id="fotosCarrusel" accept="image/*" multiple class="form-control mb-2">
    <div id="miniaturas" class="d-flex gap-2" style="flex-wrap:wrap"></div>
    <h6 class="mt-3">➕ Nuevo producto</h6>
    <input id="p_nombre" class="form-control mb-2" placeholder="Nombre del producto">
    <input id="p_precio" type="number" min="1" class="form-control mb-2" placeholder="Precio en Bs">
    <input id="p_desc" class="form-control mb-2" placeholder="Descripción corta">
    <input id="p_items" class="form-control mb-2" placeholder="Qué trae (separado por comas)">
    <input id="p_stock" type="number" min="0" class="form-control mb-2" placeholder="Stock (vacío = sin límite)">
    <input id="p_emoji" class="form-control mb-2" placeholder="Emoji (ej: 🌵)">
    <input id="p_foto" type="file" accept="image/*" class="form-control mb-2">
    <button class="btn btn-huerta w-100" id="btnAddProd">Agregar producto</button>
  </div>
